<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>
   <extension id="app" point="org.eclipse.core.runtime.applications">
      <application cardinality="singleton-global" thread="main" visible="true">
         <run class="dev.ccm.jdtls.output.DelegatingApplication"/>
      </application>
   </extension>
   <extension point="org.eclipse.buildship.core.projectconfigurators">
      <configurator id="dev.ccm.jdtls.output.configurator"
            class="dev.ccm.jdtls.output.OutputConfigurator"
            runsAfter="org.eclipse.buildship.configurators.base"/>
   </extension>
</plugin>
