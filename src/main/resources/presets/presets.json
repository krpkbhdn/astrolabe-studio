{
  "presets": [
    {
      "key": "general",
      "version": 1,
      "name": "General",
      "description": "A baseline for most projects: coding rules for Claude plus duplicate-code checking.",
      "components": [
        {"kind": "INSTRUCTION", "name": "Duplicate code", "source": "presets/general/duplicate-code.md"},
        {"kind": "INSTRUCTION", "name": "Clean code", "source": "presets/general/clean-code.md"},
        {"kind": "INSTRUCTION", "name": "Comments", "source": "presets/general/comments.md"},
        {"kind": "INSTRUCTION", "name": "Conventions", "source": "presets/general/conventions.md"},
        {"kind": "SKILL", "name": "jscpd", "source": "author-profile/user/skills/jscpd"},
        {"kind": "SKILL", "name": "dry-refactoring", "source": "author-profile/user/skills/dry-refactoring"},
        {"kind": "FILE", "name": ".jscpd.json", "source": "presets/general/jscpd.json", "payload": {"path": ".jscpd.json", "gitignore": ["jscpd-report/"]}}
      ]
    },
    {
      "key": "frontend",
      "version": 2,
      "name": "Frontend",
      "description": "General plus browser verification (Playwright) and UI design help for web frontends.",
      "includes": ["general"],
      "match": ["frontend"],
      "components": [
        {"kind": "MARKETPLACE", "name": "claude-plugins-official", "payload": {"source": "anthropics/claude-plugins-official"}},
        {"kind": "PLUGIN", "name": "playwright@claude-plugins-official", "payload": {"scope": "local"}},
        {"kind": "PLUGIN", "name": "frontend-design@claude-plugins-official", "payload": {"scope": "local"}},
        {"kind": "INSTRUCTION", "name": "Frontend tools", "source": "presets/frontend/frontend-tools.md", "payload": {"scope": "local"}}
      ]
    },
    {
      "key": "angular",
      "version": 2,
      "name": "Angular",
      "description": "Frontend plus the Angular CLI MCP server and the official Angular developer skill.",
      "includes": ["frontend"],
      "match": ["angular", "frontend"],
      "components": [
        {"kind": "MCP_SERVER", "name": "angular-cli", "payload": {"config": {"command": "npx", "args": ["-y", "@angular/cli", "mcp"]}}},
        {"kind": "SKILL", "name": "angular-developer", "source": "author-profile/user/skills/angular-developer"},
        {"kind": "INSTRUCTION", "name": "Angular tools", "source": "presets/angular/angular-tools.md", "payload": {"scope": "local"}}
      ]
    }
  ]
}
